  "naming_rules": [
    {
      "id": "repository-checks-setting-symbol",
      "kind": "setting",
      "field": "symbols",
      "pattern": "(?:HOUSE_RULES|CHECK)(?:_[A-Z]+)+|house-rules\\.[a-z]+(?:-[a-z]+)*",
      "message": "Repository-checks environment variables are upper snake case and start with HOUSE_RULES_ (read by the runner) or CHECK_ (set for a check); clone settings are house-rules.<lower kebab case>."
    },
    {
      "id": "repository-checks-interface-symbol",
      "kind": "interface",
      "field": "symbols",
      "pattern": "\\{[a-z]+(?:_[a-z]+)*\\}|--[a-z]+(?:-[a-z]+)*",
      "message": "Repository-checks run placeholders are a lower snake-case noun in braces; runner options are lower kebab case after two hyphens."
    }
  ]
}
